%% ═══ 區段一：Activity 標頭與 Actor 宣告 ═══
%% [ACTIVITY] 後台管理流程
%% [ACTOR] Owner -> {specs/actors/擁有者.md}

flowchart TD

%% ═══ 區段二：節點定義 ═══

    Start(( ))

    %% [STEP:1] @Owner {features/admin/auth/進入後台.feature}
    S1["@Owner<br/>以密碼登入後台（取得 JWT）"]

    %% [DECISION:1a] 選擇管理對象
    D1a{"選擇管理對象"}

    %% ── Satellite 管理 ──
    %% [STEP:2] @Owner {features/visitor/universe/瀏覽3D宇宙.feature}
    S2["@Owner<br/>列出 Satellite 清單"]

    %% [DECISION:2a] 選擇 Satellite 操作
    D2a{"選擇操作"}

    %% [BRANCH:2a:新增] @Owner {features/admin/satellite/新增衛星.feature}
    B2a_create["@Owner<br/>新增 Satellite"]

    %% [BRANCH:2a:編輯] @Owner {features/admin/satellite/編輯衛星.feature}
    B2a_edit["@Owner<br/>編輯 Satellite"]

    %% [BRANCH:2a:刪除] @Owner {features/admin/satellite/刪除衛星.feature}
    B2a_delete["@Owner<br/>發送刪除 Satellite 請求"]

    %% [DECISION:2b] 確認 SubSatellite 清單是否為空
    D2b{"SubSatellite 清單為空？"}

    %% [BRANCH:2b:是] @Owner {features/admin/satellite/刪除衛星.feature}
    B2b_empty["@Owner<br/>Satellite 刪除成功"]

    %% [BRANCH:2b:否] @Owner {features/admin/satellite/刪除衛星.feature}
    B2b_notempty["@Owner<br/>刪除被拒（409，SubSatellite 非空）"]

    %% [MERGE:2a]
    M2a(( ))

    %% ── SubSatellite 管理 ──
    %% [STEP:3] @Owner {features/visitor/universe/探索衛星.feature}
    S3["@Owner<br/>選擇 Satellite，列出 SubSatellite"]

    %% [DECISION:3a] 選擇 SubSatellite 操作
    D3a{"選擇操作"}

    %% [BRANCH:3a:新增] @Owner {features/admin/sub_satellite/新增子衛星.feature}
    B3a_create["@Owner<br/>新增 SubSatellite"]

    %% [BRANCH:3a:編輯] @Owner {features/admin/sub_satellite/編輯子衛星.feature}
    B3a_edit["@Owner<br/>編輯 SubSatellite"]

    %% [BRANCH:3a:刪除] @Owner {features/admin/sub_satellite/刪除子衛星.feature}
    B3a_delete["@Owner<br/>發送刪除 SubSatellite 請求"]

    %% [DECISION:3b] 確認 Paragraph 清單是否為空
    D3b{"Paragraph 清單為空？"}

    %% [BRANCH:3b:是] @Owner {features/admin/sub_satellite/刪除子衛星.feature}
    B3b_empty["@Owner<br/>SubSatellite 刪除成功"]

    %% [BRANCH:3b:否] @Owner {features/admin/sub_satellite/刪除子衛星.feature}
    B3b_notempty["@Owner<br/>刪除被拒（409，Paragraph 非空）"]

    %% [MERGE:3a]
    M3a(( ))

    %% ── Paragraph 管理 ──
    %% [STEP:4] @Owner {features/visitor/universe/查看段落.feature}
    S4["@Owner<br/>選擇 SubSatellite，列出 Paragraph"]

    %% [DECISION:4a] 選擇 Paragraph 操作
    D4a{"選擇操作"}

    %% [BRANCH:4a:新增] @Owner {features/admin/paragraph/新增段落.feature}
    B4a_create["@Owner<br/>新增 Paragraph"]

    %% [BRANCH:4a:編輯] @Owner {features/admin/paragraph/編輯段落.feature}
    B4a_edit["@Owner<br/>編輯 Paragraph"]

    %% [BRANCH:4a:刪除] @Owner {features/admin/paragraph/刪除段落.feature}
    B4a_delete["@Owner<br/>確認對話框 → 刪除 Paragraph"]

    %% [MERGE:4a]
    M4a(( ))

    End((( )))

%% ═══ 區段三：邊定義 ═══

    Start --> S1
    S1 --> D1a

    D1a -- Satellite管理 --> S2
    D1a -- SubSatellite管理 --> S3
    D1a -- Paragraph管理 --> S4

    S2 --> D2a
    D2a -- 新增 --> B2a_create
    D2a -- 編輯 --> B2a_edit
    D2a -- 刪除 --> B2a_delete
    B2a_create --> M2a
    B2a_edit --> M2a
    B2a_delete --> D2b
    D2b -- 是 --> B2b_empty
    D2b -- 否 --> B2b_notempty
    B2b_empty --> M2a
    B2b_notempty --> M2a
    M2a --> End

    S3 --> D3a
    D3a -- 新增 --> B3a_create
    D3a -- 編輯 --> B3a_edit
    D3a -- 刪除 --> B3a_delete
    B3a_create --> M3a
    B3a_edit --> M3a
    B3a_delete --> D3b
    D3b -- 是 --> B3b_empty
    D3b -- 否 --> B3b_notempty
    B3b_empty --> M3a
    B3b_notempty --> M3a
    M3a --> End

    S4 --> D4a
    D4a -- 新增 --> B4a_create
    D4a -- 編輯 --> B4a_edit
    D4a -- 刪除 --> B4a_delete
    B4a_create --> M4a
    B4a_edit --> M4a
    B4a_delete --> M4a
    M4a --> End
