    %% [BRANCH:3a:刪除] @Owner {features/admin/sub_satellite/刪除子衛星.feature}
    B3a_delete["@Owner<br/>確認對話框 → 刪除 SubSatellite<br/>（連同所屬 Paragraph）"]

    %% [MERGE:3a]
    M3a(( ))

    %% ── Paragraph 管理 ──
    %% [STEP:4] @Owner {features/visitor/universe/查看段落.feature}
    S4["@Owner<br/>選擇 SubSatellite，列出 Paragraph"]

