flowchart TD

%% ═══ 區段二：節點定義 ═══

    Start(( ))

    %% [STEP:1] @Owner {features/admin/auth/進入後台.feature}
    S1["@Owner<br/>以密碼登入後台（取得 JWT）"]

    %% [DECISION:1a] 選擇管理對象
    D1a{"選擇管理對象"}

    %% ── Satellite 管理 ──
    %% [STEP:2] @Owner {features/visitor/universe/瀏覽3D宇宙.feature}
