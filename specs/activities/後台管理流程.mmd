    D2a{"選擇操作"}

    %% [BRANCH:2a:新增] @Owner {features/admin/satellite/新增衛星.feature}
    B2a_create["@Owner<br/>新增 Satellite"]

    %% [BRANCH:2a:編輯] @Owner {features/admin/satellite/編輯衛星.feature}
    B2a_edit["@Owner<br/>編輯 Satellite"]

    %% [BRANCH:2a:刪除] @Owner {features/admin/satellite/刪除衛星.feature}
    B2a_delete["@Owner<br/>確認對話框 → 刪除 Satellite<br/>（連同所屬 SubSatellite 與 Paragraph）"]

    %% [MERGE:2a]
    M2a(( ))

