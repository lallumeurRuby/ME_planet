    B4a_create["@Owner<br/>新增 Paragraph"]

    %% [BRANCH:4a:編輯] @Owner {features/admin/paragraph/編輯段落.feature}
    B4a_edit["@Owner<br/>編輯 Paragraph"]

    %% [BRANCH:4a:刪除] @Owner {features/admin/paragraph/刪除段落.feature}
    B4a_delete["@Owner<br/>確認對話框 → 刪除 Paragraph"]

    %% [MERGE:4a]
    M4a(( ))

